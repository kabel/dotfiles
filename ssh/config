Host *.github.com *.github.net *.githubapp.com
	ForwardAgent no

Host *ec2.internal
	StrictHostKeyChecking no
	UserKnownHostsFile /dev/null

Host kabel-mac-mini kabel-mac-mini.local
	ControlMaster no
	ForwardAgent yes
    RemoteForward /Users/kabel/.gnupg/S.gpg-agent /Users/kevin.abel/.gnupg/S.gpg-agent.extra

Host *
	StrictHostKeyChecking ask
	VerifyHostKeyDNS ask
	NoHostAuthenticationForLocalhost yes
	IdentityFile ~/.ssh/id_ecdsa
	IdentityFile ~/.ssh/id_rsa
	UseKeychain yes
	AddKeysToAgent yes
	ControlMaster auto
	ControlPath ~/.ssh/cm/%C
	ControlPersist 30s
